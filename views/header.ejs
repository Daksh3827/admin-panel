<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Admin Panel</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="shell">
        <aside class="sidebar">
            <a class="brand" href="/students">
                <span class="brand-text">
                    <strong>Admin Panel</strong>
                    <small>Student Management</small>
                </span>
            </a>

            <nav class="side-nav">
                <span class="side-label">Menu</span>
                <a href="/students" class="side-link <%= locals.active === 'students' ? 'is-active' : '' %>">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    <span>Students</span>
                </a>
                <a href="/students/add" class="side-link <%= locals.active === 'add' ? 'is-active' : '' %>">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <line x1="19" y1="8" x2="19" y2="14" />
                        <line x1="22" y1="11" x2="16" y2="11" />
                    </svg>
                    <span>Add Student</span>
                </a>
            </nav>

            <div class="side-foot">
                <% if (user) { %>
                <form action="/logout" method="POST">
                    <button type="submit" class="btn btn-ghost btn-block">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        Logout
                    </button>
                </form>
                <% } %>
            </div>
        </aside>

        <div class="main">
            <main class="content">
                <% if (messages.success) { %>
                <div class="alert alert-success">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span><%= messages.success %></span>
                </div>
                <% } %>
