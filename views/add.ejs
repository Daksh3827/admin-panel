<%- include('header', { title: 'Add Student', active: 'add' }) %>

<div class="page-head">
    <div>
        <h1>Add Student</h1>
        <p class="page-sub">Create a new record in the directory</p>
    </div>
    <a href="/students" class="btn btn-light">Back to list</a>
</div>

<div class="panel form-panel">
    <form action="/students/add" method="POST">
        <div class="field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" value="<%= student.name || '' %>" placeholder="Enter Name" required>
        </div>

        <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= student.email || '' %>" placeholder="Enter Email" required>
        </div>

        <div class="field">
            <label for="course">Course</label>
            <input type="text" id="course" name="course" value="<%= student.course || '' %>" placeholder="e.g. BCA">
        </div>

        <div class="field">
            <label for="phone">Phone</label>
            <input type="number" id="phone" name="phone" value="<%= student.phone || '' %>" placeholder="Enter Mobile No">
        </div>

        <div class="form-actions">
            <a href="/students" class="btn btn-light">Cancel</a>
            <button type="submit" class="btn">Save Student</button>
        </div>
    </form>
</div>

<%- include('footer') %>
