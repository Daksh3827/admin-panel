<%- include('header', { title: 'Edit Student', active: 'students' }) %>

<div class="page-head">
    <div>
        <h1>Edit Student</h1>
        <p class="page-sub">Update the details of this record</p>
    </div>
    <a href="/students" class="btn btn-light">Back to list</a>
</div>

<div class="panel form-panel">
    <form action="/students/edit/<%= student._id %>" method="POST">
        <div class="field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" value="<%= student.name || '' %>" required>
        </div>

        <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= student.email || '' %>" required>
        </div>

        <div class="field">
            <label for="course">Course</label>
            <input type="text" id="course" name="course" value="<%= student.course || '' %>" placeholder="e.g. BCA">
        </div>

        <div class="field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" value="<%= student.phone || '' %>">
        </div>

        <div class="form-actions">
            <a href="/students" class="btn btn-light">Cancel</a>
            <button type="submit" class="btn">Update Student</button>
        </div>
    </form>
</div>

<%- include('footer') %>